# Google Calendar iCal (private URLs)
# Keep real values only in local .env and Streamlit secrets.
JAHDY_GOOGLE_CALENDAR_ICS=
GUILHERME_GOOGLE_CALENDAR_ICS=

# Postgres URL (Neon/Supabase). Keep real value only in local .env
DATABASE_URL=

# Backend security
BACKEND_SESSION_SECRET=
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Calendar OAuth (separate from Streamlit login)
CALENDAR_CLIENT_ID=
CALENDAR_CLIENT_SECRET=
CALENDAR_REDIRECT_URI=

# Allowed emails (comma-separated)
ALLOWED_EMAILS=

# User emails (used to define couple partnership; defaults come from ALLOWED_EMAILS order)
JAHDY_EMAIL=
GUILHERME_EMAIL=

# Backend CORS — comma-separated allowed origins for the FastAPI backend
# Example: https://jahdy-gui-dashboard.streamlit.app
ALLOWED_ORIGINS=

# Set to "development" locally to also allow localhost:8501 in CORS
ENVIRONMENT=production

# NASA APOD API key (free at https://api.nasa.gov) — leave blank to use DEMO_KEY (rate-limited)
NASA_API_KEY=
