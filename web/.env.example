# Core
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
NEXTAUTH_URL="https://your-app.vercel.app"
NEXTAUTH_SECRET="replace-with-random"

# Google OAuth (Login + Calendar)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_TOKEN_ENCRYPTION_KEY=""

# Access control
ALLOWED_EMAILS="jahdy.moreno@gmail.com,guilherme.m.rods@gmail.com"

# Optional AI assistant (Orbit) — free-tier providers; configure any subset.
# Tried in this order, moving on when one is unconfigured, rate-limited,
# overloaded or too small for the request. Models are discovered per
# provider, so no model name is needed; <PROVIDER>_MODEL (e.g. GEMINI_MODEL)
# only forces a first choice and is skipped if the provider no longer offers it.
MISTRAL_API_KEY=""   # free "Experiment" plan: phone verification, no card, ~1B tokens/month
GEMINI_API_KEY=""
GROQ_API_KEY=""      # free plan is ~8k tokens/min per request: only small requests fit
CEREBRAS_API_KEY=""
